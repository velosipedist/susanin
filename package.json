{
  "name": "susanin",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram Mini App for drilling the facts of a fixed Hong Kong Island coach tour.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "pnpm --filter @susanin/learn dev",
    "api": "pnpm --filter @susanin/api dev",
    "build": "pnpm --filter @susanin/learn build",
    "preview": "pnpm --filter @susanin/learn preview",
    "bot": "pnpm --filter @susanin/bot start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "sandcastle": "tsx .sandcastle/main.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "tsx": "^4.23.15"
  }
}
