{
	"name": "@susanin/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
		"start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"import:content": "node --env-file-if-exists=../../.env --import tsx src/import/cli.ts",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.4",
		"@susanin/shared": "workspace:*",
		"better-sqlite3": "^12.4.1",
		"drizzle-orm": "^0.44.6",
		"hono": "^4.9.12",
		"jose": "^6.2.17",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^3.2.4"
	}
}
