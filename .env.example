# Telegram bot token from @BotFather. The same token works with a local Bot API server.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# The local Telegram Bot API server. Start it with telegram-bot-api --local (see README.md).
TELEGRAM_API_BASE=http://localhost:8081

# The shared secret that admits a Telegram account into the tour.
INVITE_CODE=susanin-demo

# Public HTTPS URL of the learner Mini App build.
# Telegram requires HTTPS for web_app buttons; use a tunnel in front of `pnpm dev`.
# For a browser-only layout check this can stay at the local dev server.
WEBAPP_URL=http://localhost:5173/learn/

# Signs the API session cookie. Use a long random value; rotate only to sign everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# The bot presents this to the API's internal onboarding routes.
BOT_API_SECRET=replace-with-another-random-string

# The Susanin API. The learner app proxies /api here in development (vite.config.ts).
API_PORT=3000
API_URL=http://localhost:3000

# SQLite file, relative to apps/api when started with `pnpm api`.
DATABASE_FILE=./data/susanin.db

# Comma-separated Telegram ids that are admins. The in-app promotion arrives in issue #9.
ADMIN_IDS=

# Telegram OIDC login for the admin app (BotFather → your bot → Login Widget).
# The Client ID and Secret are shown there, separately from the bot token.
# Leave these blank to keep admin login disabled.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Must exactly match an Allowed URL registered in BotFather.
ADMIN_OIDC_REDIRECT_URI=http://localhost:3000/api/admin/auth/callback
# Where the API sends the browser after a successful login.
ADMIN_APP_URL=http://localhost:5174/admin/

# Local browser demo only: seeds a demo account and lets /api/dev/session sign in
# without Telegram. Leave false in production.
DEV_AUTH=false
DEV_TELEGRAM_ID=1
DEV_DISPLAY_NAME=Alex
