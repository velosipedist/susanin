# Telegram bot token from @BotFather. The same token works with a local Bot API server.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# The local Telegram Bot API server. Start it with telegram-bot-api --local (see README.md).
TELEGRAM_API_BASE=http://localhost:8081

# The shared secret that admits a Telegram account into the demo.
INVITE_CODE=susanin-demo

# Public HTTPS URL of the learner Mini App build. The bot appends ?group=A..E.
# Telegram requires HTTPS for web_app buttons; use a tunnel in front of `pnpm dev`.
# For a browser-only layout check this can stay at the local dev server.
WEBAPP_URL=http://localhost:5173/learn/
